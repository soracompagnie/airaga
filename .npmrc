# This is the npm configuration file for the project. It sets the default access level
# for published packages to public, enforces strict engine checks, and ensures that exact
# versions of dependencies are saved to `package.json`.
access=public

# Configure npm to use strict engine checks and save exact versions of dependencies to
# `package.json`. This helps ensure that the project is using compatible versions of Node.js
# and other dependencies, and that the exact versions are recorded for reproducibility.
engine-strict=true

# Save exact versions of dependencies to `package.json` to ensure that the same versions are
# used across different environments and installations. This can help prevent issues caused by
# incompatible versions of dependencies being installed.
save-exact=true