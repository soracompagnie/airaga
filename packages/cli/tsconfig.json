{
  "compilerOptions": {
    "composite": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "paths": {
      "airaga/*": ["../airaga/src/*"],
      "@airaga/cli/*": ["./src/*"],
      "@airaga/media/*": ["../media/src/*"],
      "@airaga/parser/*": ["../parser/src/*"]
    },
    "rootDir": "./src",
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
  "extends": "../../tsconfig.app.json",
  "include": ["src/**/*"],
  "references": [{ "path": "../parser" }, { "path": "../media" }]
}
